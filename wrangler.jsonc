{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zwawa-blog",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zwawa-blog",
      "database_id": "2f821584-a576-46dc-a333-fdd8278b4e8d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "zwawa-blog-media"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://blog.zwawa.dpdns.org"
  }
}
