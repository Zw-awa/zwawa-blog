---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import EmptyState from "../components/EmptyState.astro";
import { archiveRooms, gameWorlds, socialLinks } from "../data/site.js";
import { getPublicSiteAssets, getPublicSiteIdentity, listPublicContent, listPublicPlatformLinks } from "../lib/public-data";
import { getSiteUrl } from "../lib/server/env";

const [latest, identity, assets, managedLinks] = await Promise.all([
  listPublicContent(Astro.locals, { page: 1, limit: 6 }),
  getPublicSiteIdentity(Astro.locals),
  getPublicSiteAssets(Astro.locals),
  listPublicPlatformLinks(Astro.locals),
]);
const profileLinks = managedLinks.length ? managedLinks.map((item) => ({ ...item, shortLabel: item.label })) : socialLinks;
const siteHost = new URL(getSiteUrl(Astro.locals, Astro.url.toString())).host;
---

<BaseLayout path={Astro.url.pathname}>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">{identity.name} / PERSONAL ARCHIVE</p>
      <h1>{identity.name} <span>{identity.tagline}</span></h1>
      <p class="hero-description">{identity.description}</p>
      <div class="hero-actions">
        <a class="button primary" href="/writing">读最新文章 <span aria-hidden="true">→</span></a>
        <a class="button quiet" href="/gallery/art">进入作品展</a>
      </div>
      <ul class="hero-coordinates" aria-label="站点信息">
        <li><span>DOMAIN</span>{siteHost}</li>
        <li><span>LANG</span>中文 / ZH-CN</li>
        <li><span>STATUS</span>持续归档中</li>
      </ul>
    </div>

    <figure class:list={["hero-window", { "is-empty": !assets.homeHeroUrl }]}>
      {assets.homeHeroUrl ? (
        <img src={assets.homeHeroUrl} alt={`${identity.name} 首页主图`} loading="eager" fetchpriority="high" />
      ) : (
        <div class="hero-window-empty" aria-hidden="true"><span>ZW</span></div>
      )}
      <figcaption><span>OBSERVATION 01</span><strong>城市灯光亮起之后，档案馆开始工作。</strong></figcaption>
    </figure>
  </section>

  <form class="site-search-band" action="/search" method="get" role="search">
    <span class="search-glyph" aria-hidden="true"></span>
    <label class="sr-only" for="home-search">搜索站内内容</label>
    <input id="home-search" name="q" type="search" placeholder="搜索文章、游戏记录、作品……" autocomplete="off" />
    <button type="submit">搜索</button>
  </form>

  <section class="home-section archive-index" aria-labelledby="archive-title">
    <div class="section-heading">
      <div><p class="eyebrow">ARCHIVE ROOMS</p><h2 id="archive-title">四间常亮的房间</h2></div>
      <p>不同媒介各有自己的节奏，共享同一片夜空。</p>
    </div>
    <div class="room-grid">
      {archiveRooms.map((room) => (
        <a class="room-link" href={room.href}>
          <span>{room.index}</span>
          <div><strong>{room.title}</strong><small>{room.note}</small></div>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="latest-title">
    <div class="section-heading">
      <div><p class="eyebrow">LATEST RECORDS</p><h2 id="latest-title">最近入库</h2></div>
      <a class="text-link" href="/writing">全部写作 →</a>
    </div>
    {latest.items.length > 0 ? (
      <div class="content-grid home-content-grid">
        {latest.items.map((item) => <ContentCard item={item} compact />)}
      </div>
    ) : (
      <EmptyState title="档案柜尚未公开" description="第一批文章与作品正在夜色里整理。" />
    )}
  </section>

  <section class="home-section worlds-band" aria-labelledby="worlds-title">
    <div class="worlds-intro">
      <p class="eyebrow">MULTIPLAYER WORLDS</p>
      <h2 id="worlds-title">共同走过的世界，值得有一份长期存档。</h2>
      <p>Boss 战、建筑工程、服务器趣事和宇宙旅行，不只留在聊天记录里。</p>
      <a class="button quiet" href="/games">查看游戏专区 →</a>
    </div>
    <div class="world-signals">
      {gameWorlds.map((world) => (
        <a href={`/games?world=${world.slug}`}>
          <span>{world.mark}</span>
          <div><strong>{world.title}</strong><small>{world.english}</small></div>
        </a>
      ))}
    </div>
  </section>

  <section class="identity-strip" aria-label="外部平台">
    <p>在别处找到我</p>
    <div>
      {profileLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer"><span>{link.mark}</span>{link.shortLabel}</a>)}
    </div>
    <a class="text-link" href="/links">全部链接 →</a>
  </section>
</BaseLayout>
