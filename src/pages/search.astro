---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ContentCard from "../components/ContentCard.astro";
import EmptyState from "../components/EmptyState.astro";
import { listPublicContent } from "../lib/public-data";

const query = Astro.url.searchParams.get("q")?.trim().slice(0, 100) || "";
const result = query
  ? await listPublicContent(Astro.locals, { search: query, page: 1, limit: 50 })
  : { items: [], page: 1, limit: 50, total: 0, totalPages: 0 };
---

<BaseLayout title="搜索" description="搜索 ZWAWA 档案馆中的文章、游戏和作品。" path={Astro.url.pathname} noindex>
  <PageIntro
    eyebrow="SEARCH / 站内检索"
    title={query ? `寻找“${query}”` : "从档案里寻找一条线索。"}
    description={query ? `共找到 ${result.total} 条公开记录。` : "标题、摘要、正文与标签都可以成为入口。"}
  />

  <form class="search-form" action="/search" method="get" role="search">
    <span class="search-glyph" aria-hidden="true"></span>
    <label class="sr-only" for="archive-search">搜索档案</label>
    <input id="archive-search" name="q" type="search" value={query} placeholder="输入关键词" required autofocus />
    <button type="submit">搜索</button>
  </form>

  {query && result.items.length > 0 && (
    <div class="content-grid search-results">{result.items.map((item) => <ContentCard item={item} compact />)}</div>
  )}
  {query && result.items.length === 0 && (
    <EmptyState title="没有找到相符记录" description="换一个更短的关键词，或浏览各个档案房间。" />
  )}
</BaseLayout>
