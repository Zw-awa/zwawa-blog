---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archiveRooms, gameWorlds, socialLinks } from "../data/site.js";
import {
  contentHref,
  formatPublicDate,
  getPublicSiteAssets,
  getPublicSiteIdentity,
  listPublicContent,
  listPublicPlatformLinks
} from "../lib/public-data";
import { getSiteUrl } from "../lib/server/env";
import "../styles/prototype.css";
import "../styles/mascots.css";
import LoadingMascot from "../components/LoadingMascot.astro";

const [latest, identity, assets, managedLinks] = await Promise.all([
  listPublicContent(Astro.locals, { page: 1, limit: 6 }),
  getPublicSiteIdentity(Astro.locals),
  getPublicSiteAssets(Astro.locals),
  listPublicPlatformLinks(Astro.locals),
]);

const profileLinks = managedLinks.length
  ? managedLinks.map((item) => ({ ...item, shortLabel: item.label }))
  : socialLinks;
const siteHost = new URL(getSiteUrl(Astro.locals, Astro.url.toString())).host;
const heroUrl = assets.homeHeroUrl ?? assets.backgroundUrl;
const tickerItems = ["WRITE / 01", "PLAY / 02", "MAKE / 03", "KEEP / 04"];
---

<BaseLayout
  path={Astro.url.pathname}
  title={`${identity.name} / 数字档案展厅`}
  description={`${identity.name} 的数字档案展厅样板。`}
  bodyClass="prototype-mode"
  showMascotLoader
  showCatPet
  mascotTheme="dark"
  noindex
>
  <div class="prototype-page" data-prototype-page>
    <div class="prototype-thread-map" data-prototype-thread-map data-active-index="0" aria-hidden="true">
      <span class="prototype-thread-line prototype-thread-line-main"></span>
      <span class="prototype-thread-line prototype-thread-line-cross"></span>
      <i class="prototype-thread-node" data-thread-node="0"></i>
      <i class="prototype-thread-node" data-thread-node="1"></i>
      <i class="prototype-thread-node" data-thread-node="2"></i>
      <i class="prototype-thread-node" data-thread-node="3"></i>
      <span class="prototype-thread-worker">
        <i class="mascot-spider-leg mascot-spider-leg-a"></i>
        <i class="mascot-spider-leg mascot-spider-leg-b"></i>
        <i class="mascot-spider-leg mascot-spider-leg-c"></i>
        <i class="mascot-spider-leg mascot-spider-leg-d"></i>
        <b class="mascot-spider-body"></b>
        <b class="mascot-spider-eye mascot-spider-eye-a"></b>
        <b class="mascot-spider-eye mascot-spider-eye-b"></b>
      </span>
    </div>
    <section class="prototype-hero" aria-labelledby="prototype-title">
      <figure class:list={["prototype-hero-media", { "is-empty": !heroUrl }]} aria-hidden="true">
        {heroUrl ? (
          <img src={heroUrl} alt="" loading="eager" fetchpriority="high" />
        ) : (
          <div class="prototype-hero-fallback">
            <span>ZW</span>
            <i></i><i></i><i></i>
          </div>
        )}
        <figcaption>{identity.name} / HOME ARCHIVE</figcaption>
      </figure>

      <div class="prototype-hero-frame" aria-hidden="true">
        <span>ARCHIVE / 2026</span>
        <span>LAT {siteHost}</span>
      </div>

      <div class="prototype-hero-content">
        <p class="prototype-kicker prototype-reveal" data-prototype-reveal>
          {identity.name} / PERSONAL ARCHIVE
        </p>
        <p class="prototype-hero-index prototype-reveal" data-prototype-reveal>NO. 00 / OPEN INDEX</p>
        <h1 id="prototype-title" class="prototype-reveal" data-prototype-reveal>
          <span>{identity.name}</span>
          <em>{identity.tagline}</em>
        </h1>
        <p class="prototype-hero-description prototype-reveal" data-prototype-reveal>
          {identity.description}
        </p>
        <div class="prototype-actions prototype-reveal" data-prototype-reveal>
          <a class="prototype-button prototype-button-primary" href="/writing">打开最新记录 <span aria-hidden="true">↗</span></a>
          <a class="prototype-button prototype-button-quiet" href="/gallery/art">进入作品展</a>
        </div>
      </div>

      <div class="prototype-hero-footer" aria-hidden="true">
        <span>ZH-CN / CONTINUOUSLY ARCHIVING</span>
        <span class="prototype-scroll-mark">↓</span>
      </div>
    </section>

    <div class="prototype-ticker" aria-label="档案栏目">
      <div class="prototype-ticker-track">
        {[...tickerItems, ...tickerItems].map((item) => <span>{item}</span>)}
      </div>
    </div>

    <section class="prototype-section prototype-stage prototype-rooms" data-thread-index="0" aria-labelledby="prototype-rooms-title">
      <header class="prototype-section-heading prototype-reveal" data-prototype-reveal>
        <div>
          <p class="prototype-kicker">ARCHIVE ROOMS</p>
          <h2 id="prototype-rooms-title">四个入口，通往同一座档案馆。</h2>
        </div>
        <p>不同媒介各有自己的节奏，共享同一片夜空。</p>
      </header>

      <div class="prototype-room-list">
        {archiveRooms.map((room, index) => (
          <a
            class="prototype-room prototype-reveal"
            data-prototype-reveal
            data-room-index={index}
            style={`--prototype-delay: ${index * 70}ms`}
            href={room.href}
          >
            <span class="prototype-room-number">{room.index}</span>
            <span class="prototype-room-copy">
              <strong>{room.title}</strong>
              <small>{room.note}</small>
            </span>
            <span class="prototype-room-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="prototype-section prototype-stage prototype-records" data-thread-index="1" aria-labelledby="prototype-records-title">
      <header class="prototype-section-heading prototype-reveal" data-prototype-reveal>
        <div>
          <p class="prototype-kicker">LATEST RECORDS / {String(latest.total).padStart(2, "0")}</p>
          <h2 id="prototype-records-title">最近入库</h2>
        </div>
        <a class="prototype-text-link" href="/writing">查看全部记录 <span aria-hidden="true">↗</span></a>
      </header>

      {latest.items.length > 0 ? (
        <div class="prototype-record-list">
          {latest.items.map((item, index) => (
            <article class="prototype-record prototype-reveal" data-prototype-reveal style={`--prototype-delay: ${index * 80}ms`}>
              <span class="prototype-record-number">{String(index + 1).padStart(2, "0")}</span>
              <a class:list={["prototype-record-media", { "is-empty": !item.coverUrl }]} href={contentHref(item)} tabindex="-1" aria-hidden="true">
                {item.coverUrl ? <img src={item.coverUrl} alt="" loading="lazy" /> : <span>{item.typeLabel}</span>}
              </a>
              <div class="prototype-record-copy">
                <div class="prototype-record-meta">
                  <span>{item.typeLabel}</span>
                  {item.publishedAt && <time datetime={item.publishedAt}>{formatPublicDate(item.publishedAt)}</time>}
                </div>
                <h3><a href={contentHref(item)}>{item.title}</a></h3>
                {item.summary && <p>{item.summary}</p>}
              </div>
              <a class="prototype-record-open" href={contentHref(item)} aria-label={`打开《${item.title}》`}>
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="prototype-empty prototype-reveal" data-prototype-reveal>
          <span class="prototype-empty-index">00</span>
          <div>
            <strong>档案柜尚未公开</strong>
            <p>第一批文章与作品正在夜色里整理。</p>
          </div>
        </div>
      )}
    </section>

    <section class="prototype-section prototype-stage prototype-worlds" data-thread-index="2" aria-labelledby="prototype-worlds-title">
      <div class="prototype-worlds-copy prototype-reveal" data-prototype-reveal>
        <p class="prototype-kicker">MULTIPLAYER WORLDS</p>
        <h2 id="prototype-worlds-title">共同走过的世界，也值得一份长期存档。</h2>
        <p>从第一棵树到最后一场 Boss 战，留下那些只有同行者知道的坐标。</p>
        <a class="prototype-text-link" href="/games">查看游戏专区 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="prototype-world-list">
        {gameWorlds.map((world, index) => (
          <a class="prototype-world prototype-reveal" data-prototype-reveal style={`--prototype-delay: ${index * 70}ms`} href={`/games?world=${world.slug}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{world.title}</strong>
            <small>{world.english}</small>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </section>

    <section class="prototype-section prototype-stage prototype-network" data-thread-index="3" aria-labelledby="prototype-network-title">
      <div class="prototype-network-heading prototype-reveal" data-prototype-reveal>
        <p class="prototype-kicker">ELSEWHERE / {String(profileLinks.length).padStart(2, "0")}</p>
        <h2 id="prototype-network-title">在别处继续相遇。</h2>
      </div>
      <div class="prototype-network-links">
        {profileLinks.map((link, index) => (
          <a class="prototype-network-link prototype-reveal" data-prototype-reveal style={`--prototype-delay: ${index * 55}ms`} href={link.href} target="_blank" rel="noreferrer">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{link.shortLabel}</strong>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </section>

    {/*
      ================= 加载动画演示（可整体移除） =================
      LoadingMascot 组件样板：弹跳小蜘蛛 + 逐字波浪文案，
      机制参照 Umi-OCR 的 Loading.qml。
      - 上方卡片默认 data-state="run"，点按钮可暂停/继续（组件本身支持任意时刻
        切换 data-state，即 running 的动态开关）。
      - 下方卡片 running={false}，展示静止态。
      所在页面需引入 mascots.css（本页已引入）。
    */}
    <section class="loading-mascot-demo" aria-labelledby="loading-mascot-demo-title">
      <header class="loading-mascot-demo-head">
        <p>SYSTEM / LOADING</p>
        <h3 id="loading-mascot-demo-title">读取中的小动画</h3>
        <p class="loading-mascot-demo-note">
          弹跳吉祥物 + 逐字波浪，对应 Umi-OCR 截图识别时那个“团子跳动 + OCR…
          逐字点亮”的效果。开启系统“减弱动态”后会自动静置；移到视野外也会暂停。
        </p>
      </header>
      <div class="loading-mascot-demo-row">
        <div class="loading-mascot-demo-item">
          <LoadingMascot text="正在读取档案…" />
          <button type="button" data-loading-mascot-demo-toggle data-paused="0">暂停演示</button>
          <span class="loading-mascot-demo-caption">运行中 · data-state="run"</span>
        </div>
        <div class="loading-mascot-demo-item">
          <LoadingMascot text="已放入归档队列" running={false} />
          <span class="loading-mascot-demo-caption">静止 · running=false</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const demo = document.querySelector("[data-loading-mascot-demo-toggle]");
    if (!(demo instanceof HTMLButtonElement) || demo.dataset.init === "true") return;
    demo.dataset.init = "true";

    const mascot = demo.closest(".loading-mascot-demo-item")?.querySelector("[data-loading-mascot]");
    const toggle = () => {
      if (!(mascot instanceof HTMLElement)) return;
      const paused = demo.dataset.paused === "1";
      mascot.dataset.state = paused ? "run" : "idle";
      demo.dataset.paused = paused ? "0" : "1";
      demo.textContent = paused ? "暂停演示" : "继续演示";
    };
    demo.addEventListener("click", toggle);
  })();
</script>

<script is:inline>
  (() => {
    const page = document.querySelector("[data-prototype-page]");
    if (!(page instanceof HTMLElement)) return;

    const header = document.querySelector(".prototype-mode .site-header");
    const threadMap = page.querySelector("[data-prototype-thread-map]");
    const threadNodes = [...page.querySelectorAll("[data-thread-node]")];
    const threadSections = [...page.querySelectorAll("[data-thread-index]")];
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const revealItems = page.querySelectorAll("[data-prototype-reveal]");

    if (reduceMotion.matches || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver((entries, currentObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          currentObserver.unobserve(entry.target);
        });
      }, { rootMargin: "0px 0px -12%", threshold: 0.08 });
      revealItems.forEach((item) => observer.observe(item));
    }

    let frame = 0;
    const syncScroll = () => {
      frame = 0;
      const progress = Math.min(1, window.scrollY / Math.max(1, window.innerHeight * 0.9));
      page.style.setProperty("--prototype-scroll", progress.toFixed(3));
      if (header) {
        header.toggleAttribute("data-prototype-scrolled", window.scrollY > 24);
        header.style.setProperty("--prototype-scroll", progress.toFixed(3));
      }
      if (threadMap instanceof HTMLElement && threadSections.length > 0) {
        const threshold = window.innerHeight * 0.42;
        let activeIndex = 0;
        threadSections.forEach((section, index) => {
          if (section.getBoundingClientRect().top <= threshold) activeIndex = index;
        });
        threadMap.dataset.activeIndex = String(activeIndex);
        threadNodes.forEach((node, index) => node.toggleAttribute("data-active", index === activeIndex));
      }
    };
    const requestScrollSync = () => {
      if (!frame) frame = window.requestAnimationFrame(syncScroll);
    };
    window.addEventListener("scroll", requestScrollSync, { passive: true });
    syncScroll();

    window.addEventListener("mascot:fetch", (event) => {
      if (!(threadMap instanceof HTMLElement)) return;
      const detail = event instanceof CustomEvent ? event.detail : {};
      const targetIndex = Math.max(0, Math.min(threadNodes.length - 1, Number(detail?.targetIndex ?? 0)));
      threadMap.dataset.pulseIndex = String(targetIndex);
      threadMap.classList.remove("is-pulsing");
      void threadMap.offsetWidth;
      threadMap.classList.add("is-pulsing");
      window.setTimeout(() => {
        threadMap.classList.remove("is-pulsing");
      }, reduceMotion.matches ? 180 : 1300);
    });

    if (!reduceMotion.matches && window.matchMedia("(pointer: fine)").matches) {
      page.addEventListener("pointermove", (event) => {
        const x = (event.clientX / Math.max(1, window.innerWidth) - 0.5) * -12;
        const y = (event.clientY / Math.max(1, window.innerHeight) - 0.5) * -8;
        page.style.setProperty("--prototype-pointer-x", `${x.toFixed(2)}px`);
        page.style.setProperty("--prototype-pointer-y", `${y.toFixed(2)}px`);
      }, { passive: true });
    }

    page.querySelectorAll(".prototype-room, .prototype-record, .prototype-world, .prototype-network-link").forEach((item) => {
      item.addEventListener("pointermove", (event) => {
        const rect = item.getBoundingClientRect();
        item.style.setProperty("--prototype-card-x", `${((event.clientX - rect.left) / Math.max(1, rect.width) * 100).toFixed(1)}%`);
        item.style.setProperty("--prototype-card-y", `${((event.clientY - rect.top) / Math.max(1, rect.height) * 100).toFixed(1)}%`);
      }, { passive: true });
    });
  })();
</script>
