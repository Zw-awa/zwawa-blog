---
interface Props {
  page: number;
  totalPages: number;
  pathname: string;
  params?: Record<string, string>;
}

const { page, totalPages, pathname, params = {} } = Astro.props;

const pageHref = (target: number) => {
  const search = new URLSearchParams(params);
  if (target > 1) search.set("page", String(target));
  else search.delete("page");
  const suffix = search.toString();
  return suffix ? `${pathname}?${suffix}` : pathname;
};
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="分页">
    {page > 1 ? <a href={pageHref(page - 1)}>← 上一页</a> : <span aria-disabled="true">← 上一页</span>}
    <p><strong>{page}</strong><span>/</span>{totalPages}</p>
    {page < totalPages ? <a href={pageHref(page + 1)}>下一页 →</a> : <span aria-disabled="true">下一页 →</span>}
  </nav>
)}
