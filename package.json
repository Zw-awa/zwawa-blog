{
  "name": "my-blog-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev",
    "start": "node scripts/run-astro.mjs dev",
    "build": "node scripts/run-astro.mjs build",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "preview": "node scripts/run-astro.mjs preview",
    "check": "node scripts/run-astro.mjs check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-playwright.mjs test",
    "test:e2e:install": "node scripts/run-playwright.mjs install chromium",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file scripts/seed-local.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/react": "^6.0.1",
    "@codemirror/lang-markdown": "^6.5.1",
    "@uiw/react-codemirror": "^4.25.11",
    "astro": "^7.1.3",
    "fast-xml-parser": "^5.10.1",
    "fast-xml-validator": "^1.4.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.1.2",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260723.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.83.0"
  },
  "overrides": {
    "sharp": "0.35.3",
    "svgo": "4.0.2"
  }
}
